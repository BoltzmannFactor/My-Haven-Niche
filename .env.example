# 复制为 .env.local 后填入真实值：cp .env.example .env.local
#
# ⚠️ 下面四个变量都只在服务端读取，**绝不能**加 NEXT_PUBLIC_ 前缀，
#    否则会被打进浏览器 bundle，等于把口令和仓库写权限公开出去。

# 说说在网页端发布时用的口令。
# 不填的话页面上不会出现发布框（只读模式），站点照常运行。
POST_PASSWORD=

# 会话 Cookie 的 HMAC 签名密钥，随便填一串够长的随机字符即可。
# 和 POST_PASSWORD 必须同时存在，缺一个发布功能就整体关闭。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 发布说说的目标仓库，格式是 owner/repo。
GITHUB_REPO=BoltzmannFactor/My-Haven-Niche

# GitHub 个人访问令牌（fine-grained）。
# 只需勾选这一个仓库的 Contents: Read and write 权限。
# 拿到它等于能往仓库写文件，务必保管好。
GITHUB_TOKEN=

# 站点正式地址，用于生成 sitemap.xml、robots.txt 和 OG 图的绝对链接。
# 不填的话 sitemap 里会是 https://example.com，搜索引擎拿不到有效地址。
# Vercel 部署后把这个值设为 https://你的域名
NEXT_PUBLIC_SITE_URL=

# 全站维护模式开关。设为 1 后所有页面会被重写到 /maintenance。
# 注意：这是构建期读取的变量，改完需要重新构建 / 部署。
MAINTENANCE_MODE=

# 维护页显示的预计恢复时间文案，可留空。
NEXT_PUBLIC_MAINTENANCE_ETA=
